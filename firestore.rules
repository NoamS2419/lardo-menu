rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20
        && !n.matches('.*[\\u0000-\\u001F\\u202A-\\u202E\\u2066-\\u2069<>].*');
    }

    match /names/{nameKey} {
      allow read: if signedIn();
      allow create: if signedIn() && nameKey.size() <= 20
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(resource.data.uid);
      allow update: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'total', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /daily/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && docId == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'score', 'createdAt', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp;
      allow update: if false;            // תוצאה יומית אחת, אי אפשר לשפר אחרי
      allow delete: if isOwner(resource.data.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
